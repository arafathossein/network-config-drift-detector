# Where daily backups are kept (one folder per device). Keep this folder private.
BACKUP_DIR=data/backups
KEEP_DAYS=90

# SSH credentials, read by the SSH collector. Use a read-only account.
NCD_USERNAME=
NCD_PASSWORD=

# Optional: a language model for plain-English summaries (any OpenAI-compatible API).
# Local example with Ollama:  LLM_BASE_URL=http://127.0.0.1:11434/v1  LLM_MODEL=llama3.1:8b
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=llama3.1:8b

# Optional: Slack incoming webhook for changes at or above SLACK_MIN_SEVERITY (info, low, medium, high)
SLACK_WEBHOOK_URL=
SLACK_MIN_SEVERITY=medium
# Optional link added to the Slack message, e.g. where you publish the HTML report
REPORT_URL=
